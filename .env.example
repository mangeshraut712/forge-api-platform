# Infrastructure
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge?schema=public
REDIS_URL=redis://localhost:6379
QUOTA_FAIL_MODE=open

# API (apps/api)
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Use a random value of at least 32 characters in production.
API_KEY_HASH_PEPPER=dev-pepper-change-me
NODE_ENV=development

# Dashboard (apps/dashboard)
# Generate a separate long random value for production.
AUTH_SECRET=generate-a-long-random-string
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Dev-only credentials provider (no Google required)
AUTH_DEV_LOGIN=true

# Todo demo (apps/todo-demo)
FORGE_API_KEY=
FORGE_BASE_URL=http://localhost:4000
